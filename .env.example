# Copy to .env (deploy/setup.sh does this and fills in random passwords).
AGRIA_MQTT_USERNAME=agria
AGRIA_MQTT_PASSWORD=change-me
# Required for acknowledging alerts and logging calibrations from the dashboard.
AGRIA_API_TOKEN=change-me
# Credentials the ESPHome nodes use (put the same values in firmware/esphome/secrets.yaml).
NODE_MQTT_USERNAME=node
NODE_MQTT_PASSWORD=change-me
# Simulator (only used with: docker compose --profile sim up)
SIM_MQTT_USERNAME=node
SIM_MQTT_PASSWORD=change-me
AGRIA_LOG_LEVEL=INFO
